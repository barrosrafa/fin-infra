      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "targets": [{ "expr": "sum(rate(pg_stat_database_xact_commit[5m]))", "refId": "A" }],
      "title": "Transações Commitadas / seg",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
