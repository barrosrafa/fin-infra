{
  "name": "fin-ingestion-watchdog",
  "main": "src/index.js",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {"GITHUB_REPOSITORY": "barrosrafa/fin-ingestion", "WORKFLOW": "engine-schedule.yml"},
  "observability": {"enabled": true}
}
