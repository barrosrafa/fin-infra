worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events { worker_connections 1024; }

http {
    access_log /var/log/nginx/access.log;
    server_tokens off;
    resolver 1.1.1.1 1.0.0.1 valid=60s ipv6=off;
    limit_req_zone $binary_remote_addr zone=staging_api:10m rate=15r/s;

    upstream fin_staging_api {
        server ${API_STAGING_HOST}:443;
        keepalive 16;
    }

    server {
        listen 8080;
        server_name _;

        location = /healthz {
            proxy_pass https://fin_staging_api/health;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host ${API_STAGING_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${API_STAGING_HOST};
            proxy_connect_timeout 3s;
            proxy_read_timeout 5s;
        }

        location /api/v1/ {
            limit_req zone=staging_api burst=30 nodelay;
            proxy_pass https://fin_staging_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host ${API_STAGING_HOST};
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_ssl_server_name on;
            proxy_ssl_name ${API_STAGING_HOST};
            proxy_connect_timeout 5s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
            add_header Cache-Control "private, no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location / { return 404; }
    }
}
