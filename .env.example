# ==========================================
# FIN-INFRA — Environment Variables Template
# ==========================================

# AWS Credentials & Config
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
TF_VAR_environment=staging

# Lightweight staging API gateway (used by fin-web Preview deployments)
API_STAGING_HOST=fin-api-staging.example.koyeb.app
API_STAGING_GATEWAY_PORT=8088

# Neon Serverless PostgreSQL 18
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/fin?sslmode=require
DATABASE_POOL_SIZE=20

# Redis Cache & ARQ Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Payment Gateways (Billing)
ASAAS_API_KEY=$aact_your_asaas_api_key
ASAAS_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Scraper Egress Gateway & Proxies
RESIDENTIAL_PROXY_URL=http://user:pass@pr.residential.proxyprovider.com:8080
DATACENTER_PROXY_URL=http://user:pass@dc.proxyprovider.com:8080
CLUBE_FII_JWT_SECRET=your-clube-fii-token

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
